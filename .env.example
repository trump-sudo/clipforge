APP_NAME=ClipForge
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=clipforge
DB_USERNAME=clipforge
DB_PASSWORD=secret

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
# Must be greater than the job timeout (600s), otherwise a long encode gets picked up twice.
REDIS_QUEUE_RETRY_AFTER=700

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
IMAGEMAGICK_BIN=convert

CATALOG_CACHE_TTL=300
UPLOAD_MAX_KB=512000
